datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String              @id @default(uuid())
  telegramId        BigInt?             @unique
  email             String?             @unique
  authMethod        String              @default("TELEGRAM") // TELEGRAM, WEB3, EMAIL
  username          String?
  firstName         String?
  lastName          String?
  photoUrl          String?
  isAdmin           Boolean             @default(false)
  isBanned          Boolean             @default(false)
  banReason         String?
  referralCode      String              @unique
  referredById      String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  telegramProfile   TelegramProfile?
  wallet            Wallet?
  gameStats         GameStats?
  garlicInventory   GarlicInventory?
  garlicBoxes       GarlicBox[]
  gameCurrency      GameCurrency?
  upgrades          UserUpgrade[]
  quests            UserQuest[]
  referralsMade     Referral[]          @relation("Referrer")
  referralReceived  Referral?           @relation("Referred")
  achievements      UserAchievement[]
  presaleContributions PresaleContribution[]
  tokenClaims       TokenClaim[]
  transactions      Transaction[]
  antiCheatEvents   AntiCheatEvent[]
}

model TelegramProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  telegramId   BigInt   @unique
  username     String?
  firstName    String?
  languageCode String?
  isPremium    Boolean  @default(false)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Wallet {
  id            String   @id @default(uuid())
  userId        String   @unique
  address       String   @unique
  chainId       Int      @default(1)
  connectedAt   DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GameStats {
  id                   String   @id @default(uuid())
  userId               String   @unique
  level                Int      @default(1)
  xp                   Int      @default(0)
  energy               Int      @default(1000)
  maxEnergy            Int      @default(1000)
  energyRegenRate      Int      @default(1) // +1 energy per X seconds
  energyRegenSeconds   Int      @default(3)
  tapsPerGarlic        Int      @default(100)
  currentGarlicTaps    Int      @default(0)
  totalTaps            Int      @default(0)
  totalGarlicHarvested Int      @default(0)
  totalBoxesCompleted  Int      @default(0)
  totalAjoEarned       Float    @default(0.0)
  lastTapAt            DateTime @default(now())
  lastEnergyUpdateAt   DateTime @default(now())
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GarlicInventory {
  id         String   @id @default(uuid())
  userId     String   @unique
  rawGarlic  Int      @default(0)
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GarlicBox {
  id          String   @id @default(uuid())
  userId      String
  boxType     String   // BASIC, FARM, MEGA
  capacity    Int      @default(100)
  currentCount Int     @default(0)
  isFull      Boolean  @default(false)
  claimedAjo  Boolean  @default(false)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GameCurrency {
  id         String   @id @default(uuid())
  userId     String   @unique
  gcBalance  Int      @default(0) // Garlic Coins (GC)
  ajoBalance Float    @default(0.0) // Virtual AJO Balance
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Upgrade {
  id           String        @id @default(uuid())
  code         String        @unique // STRONGER_FINGERS, BIGGER_HANDS, FAST_REGEN, GARLIC_MULTIPLIER, BIGGER_BOXES
  name         String
  description  String
  baseCost     Int
  costMultiplier Float       @default(1.5)
  maxLevel     Int           @default(50)
  userUpgrades UserUpgrade[]
}

model UserUpgrade {
  id         String   @id @default(uuid())
  userId     String
  upgradeId  String
  level      Int      @default(0)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  upgrade    Upgrade  @relation(fields: [upgradeId], references: [id], onDelete: Cascade)

  @@unique([userId, upgradeId])
}

model Quest {
  id          String      @id @default(uuid())
  code        String      @unique
  title       String
  description String
  rewardGc    Int
  rewardAjo   Float       @default(0.0)
  targetValue Int
  questType   String      // TAPS, HARVEST, BOX, REFERRAL, WALLET
  userQuests  UserQuest[]
}

model UserQuest {
  id          String    @id @default(uuid())
  userId      String
  questId     String
  progress    Int       @default(0)
  isCompleted Boolean   @default(false)
  isClaimed   Boolean   @default(false)
  claimedAt   DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest       Quest     @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([userId, questId])
}

model Referral {
  id          String   @id @default(uuid())
  referrerId  String
  referredId  String   @unique
  tier        Int      @default(1)
  rewardGc    Int      @default(500)
  createdAt   DateTime @default(now())
  referrer    User     @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred    User     @relation("Referred", fields: [referredId], references: [id], onDelete: Cascade)
}

model LeaderboardSnapshot {
  id          String   @id @default(uuid())
  snapshotType String  // GLOBAL, WEEKLY, DAILY
  rankingsJson String
  createdAt   DateTime @default(now())
}

model Achievement {
  id               String            @id @default(uuid())
  code             String            @unique
  name             String
  description      String
  icon             String
  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(uuid())
  userId        String
  achievementId String
  unlockedAt    DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

model PresaleContribution {
  id            String   @id @default(uuid())
  userId        String
  walletAddress String
  amountEth     Float
  tokenAmount   Float
  txHash        String   @unique
  status        String   @default("COMPLETED")
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TokenClaim {
  id            String   @id @default(uuid())
  userId        String
  boxId         String?
  amountAjo     Float
  walletAddress String
  txHash        String?
  status        String   @default("PENDING") // PENDING, CONFIRMED, FAILED
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id          String   @id @default(uuid())
  userId      String
  type        String   // SELL_GARLIC, BUY_BOX, CLAIM_AJO, UPGRADE, QUEST_REWARD
  amount      Float
  currency    String   // GC, AJO, GARLIC
  description String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminAction {
  id        String   @id @default(uuid())
  adminId   String
  action    String
  targetId  String?
  details   String
  createdAt DateTime @default(now())
}

model AntiCheatEvent {
  id        String   @id @default(uuid())
  userId    String
  severity  String   // LOW, MEDIUM, HIGH, CRITICAL
  reason    String
  metadata  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
